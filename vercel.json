{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "runtime": "python3.12",
      "entrypoint": "app.py",
      "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "runtime": "python3.12",
      "entrypoint": "app.main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/deploy(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}